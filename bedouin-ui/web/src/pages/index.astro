---
import '../styles/bedouin.css';

// The page is static. Everything below fills in from /api/state, because the
// machine is what changes, not the markup.
const SECTIONS = [
  'plan',
  'packages',
  'files',
  'repos',
  'links',
  'aliases',
  'languages',
  'doctor',
  'env',
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>bedouin</title>
    <link rel="icon" href='data:image/svg+xml,%3Csvg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"%3E%3Cpath fill="%23a82a24" fill-rule="evenodd" d="M 3 50 Q 12 46 22 12 Q 32 34 42 12 Q 52 46 61 50 Z M 26 50 L 26 37 Q 32 32 38 37 L 38 50 Z"/%3E%3C/svg%3E' />
  </head>
  <body>
    <svg class="sprite" aria-hidden="true">
      <defs>
        <g id="i-package"><path d="M12 3 21 8v8l-9 5-9-5V8Z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></g>
        <g id="i-file"><path d="M6 3h8l4 4v14H6Z"/><path d="M14 3v4h4"/></g>
        <g id="i-repo"><circle cx="7" cy="6" r="2"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="10" r="2"/><path d="M7 8v8"/><path d="M17 12c0 4-4 3-10 5"/></g>
        <g id="i-link"><path d="M4 12h12"/><path d="m12 8 4 4-4 4"/><path d="M20 5v14"/></g>
        <g id="i-alias"><path d="M4 8h7"/><path d="M4 16h16"/><path d="m8 12 3 4-3 4" opacity="0"/></g>
        <g id="i-language"><path d="m6 8 4 4-4 4"/><path d="M13 16h5"/></g>
        <g id="i-manager"><path d="M12 3 21 8l-9 5-9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 16 9 5 9-5"/></g>
        <g id="i-dir"><path d="M3 7h7l2 2h9v10H3Z"/></g>
        <g id="i-rc"><path d="M6 3h12v18H6Z"/><path d="M9 8h6"/><path d="M9 12h6"/><path d="M9 16h4"/></g>
        <g id="i-path"><path d="M6 21 11 3"/><path d="M18 21 13 3"/><path d="M12 7v2"/><path d="M12 12v2"/><path d="M12 17v2"/></g>
        <g id="i-env"><path d="M9 4C6 4 7 11 4 12c3 1 2 8 5 8"/><path d="M15 4c3 0 2 7 5 8-3 1-2 8-5 8"/></g>
        <g id="i-drift"><path d="M12 4 22 20H2Z"/><path d="M12 10v4"/><path d="M12 17h.01"/></g>
        <g id="i-search"><circle cx="10.5" cy="10.5" r="6"/><path d="m15 15 5 5"/></g>
        <g id="i-add"><path d="M12 5v14"/><path d="M5 12h14"/></g>
        <g id="i-edit"><path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16Z"/><path d="m14 6 4 4"/></g>
        <g id="i-delete"><path d="M4 7h16"/><path d="M9 7V4h6v3"/><path d="M6 7l1 13h10l1-13"/></g>
        <g id="i-save"><path d="m5 12 5 6L19 6"/></g>
        <g id="i-cancel"><path d="m6 6 12 12"/><path d="m18 6-12 12"/></g>
      </defs>
    </svg>

    <div class="wrap">
      <div class="crest">
        <svg class="mark" viewBox="0 0 64 64" aria-hidden="true">
          <path
            fill="currentColor"
            fill-rule="evenodd"
            d="M 3 50 Q 12 46 22 12 Q 32 34 42 12 Q 52 46 61 50 Z M 26 50 L 26 37 Q 32 32 38 37 L 38 50 Z"
          />
        </svg>
        <span class="wordmark">bedouin</span>
        <label class="find">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-search"/></svg>
          <input
            id="q"
            type="search"
            placeholder="search   /"
            autocomplete="off"
            spellcheck="false"
            aria-label="Search everything in this config"
          />
        </label>
        <div class="machine" id="machine">reading this machine…</div>
      </div>

      <!-- The only fact most visits are here for, in the largest type. -->
      <p class="verdict" id="verdict"></p>
    </div>

    <!-- The plan, one thread per item, dyed by what it does. Hidden from
         assistive tech and out of the tab order on purpose: it is a pointer
         shortcut to the list below, which carries the same items in the same
         order with real names, and 60-odd tab stops in front of the content
         would be a worse page for the people it claims to help. -->
    <div class="band" id="band" aria-hidden="true"></div>

    <div class="wrap">
      <div id="warnings" role="status"></div>
      <div id="note" role="alert"></div>

      <nav id="tabs" role="tablist">
        {
          SECTIONS.map((id) => (
            <button role="tab" data-section={id} aria-selected={id === 'plan'}>
              {id}
              <span class="n" data-count={id} />
            </button>
          ))
        }
      </nav>

      <main>
        <section class="panel" aria-label="items">
          <div id="new"></div>
          <ul class="rows" id="rows"></ul>
        </section>
        <section class="panel aside" aria-label="details">
          <div id="details" class="hint">Pick something on the left.</div>
        </section>
      </main>

      <footer id="foot"></footer>
    </div>

    <script>
      const TENT = [
        '        /\\          /\\        ',
        '       /  \\        /  \\       ',
        '      /    \\      /    \\      ',
        '     /      \\    /      \\     ',
        '    /        \\__/        \\    ',
        '   /                      \\   ',
        '  /         ______         \\  ',
        ' /_________/      \\_________\\ ',
      ].join('\n');

      // An empty section is an invitation, not a dead end: say what would go
      // there and the one command that puts it there.
      const EMPTY = {
        plan: ['Nothing to do. Every declared thing is already on this machine.', ''],
        packages: ['No packages declared.', 'bedouin add cargo:zellij'],
        files: ['No files declared. A file is a template in your config repo, and where it lands.', ''],
        repos: ['No repos declared. A repo is a clone bedouin keeps up to date.', ''],
        links: ['No links declared. A link points somewhere already on disk.', ''],
        aliases: ['No aliases declared.', "bedouin alias gs='git status'"],
        languages: ['No languages declared. A language is a toolchain and the version you want.', ''],
        doctor: ['Nothing has drifted. Every managed file still says what bedouin wrote.', ''],
        env: ['This config reads no environment variables.', ''],
      };

      // What a new entry needs, in the order it will be written. The first
      // is the section's identifying field.
      const NEW = {
        packages: ['name', 'from', 'version'],
        languages: ['name', 'installer', 'version'],
        files: ['src', 'dest', 'mode'],
        repos: ['url', 'dest'],
        links: ['src', 'dest'],
        aliases: ['name', 'value'],
      };

      let snap = null;
      let section = 'plan';
      let selected = 0;
      let query = '';
      let writable = false;

      const $ = (id) => document.getElementById(id);
      const esc = (s) =>
        String(s).replace(/[&<>"']/g, (c) => ({
          '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
        })[c]);

      function rowsFor(s) {
        if (!snap) return [];
        if (s === 'plan') return snap.plan.items;
        if (s === 'doctor')
          return snap.doctor.map((d) => ({
            id: d.id, kind: d.what, name: d.id, detail: d.detail,
            sigil: '!', fields: [['what', d.what], ['detail', d.detail]],
          }));
        if (s === 'env')
          return snap.env.map((e) => ({
            id: e.name, kind: e.set ? 'set' : 'unset', name: e.name,
            detail: e.site, sigil: e.set ? ' ' : '?',
            fields: [
              ['read at', e.site],
              ['state', e.set ? 'set' : 'not set'],
              ['if unset', e.match_key
                ? 'the target simply does not match'
                : e.has_default
                  ? 'falls back to its | default(…)'
                  : 'resolve fails — nothing to fall back to'],
            ],
          }));
        return snap.config[s] || [];
      }

      /// Everything a row shows, flattened once so a search reads what the eye
      /// reads: the name, the detail beside it, and every field in the pane
      /// that opens when you pick it.
      function haystack(r) {
        return [r.name, r.detail, r.kind, ...(r.fields || []).flat()]
          .join('\u0000')
          .toLowerCase();
      }

      const sections = () => [...$('tabs').children].map((b) => b.dataset.section);

      function rowsIn(s) {
        const rows = rowsFor(s);
        if (!query) return rows;
        const q = query.toLowerCase();
        return rows.filter((r) => haystack(r).includes(q));
      }

      // A row's kind is a manager name for a package (apt, cargo) and an item
      // kind for a plan row (dir, rc, path). Both map onto one mark.
      // Spelled out, because stripping an `s` gets "aliase" and stripping
      // `e?s` gets "packag".
      const ONE = {
        packages: 'package', files: 'file', repos: 'repo', links: 'link',
        aliases: 'alias', languages: 'language',
      };

      const MARK = {
        package: 'package', file: 'file', repo: 'repo', link: 'link',
        alias: 'alias', language: 'language', manager: 'manager',
        dir: 'dir', rc: 'rc', path: 'path', env: 'env',
      };

      function markFor(r, s) {
        if (s === 'doctor') return 'drift';
        if (s === 'env') return 'env';
        if (MARK[r.kind]) return MARK[r.kind];
        // A package's kind is the manager that installs it.
        return MARK[s === 'plan' ? r.kind : ONE[s]] || 'package';
      }

      const icon = (id, cls = '') =>
        `<svg class="ico ${cls}" viewBox="0 0 24 24" aria-hidden="true">` +
        `<use href="#i-${id}"/></svg>`;

      const dye = (c) =>
        ({ '+': 'add', '~': 'change', '-': 'remove', '!': 'remove', '?': 'change' })[c] || '';

      function renderVerdict() {
        const c = snap.plan.counts;
        const tally = [['add', c.add], ['change', c.change], ['remove', c.remove]]
          .filter(([, n]) => n);
        const el = $('verdict');
        if (!tally.length) {
          el.className = 'verdict pitched';
          el.textContent = 'camp is pitched';
          return;
        }
        el.className = 'verdict';
        el.innerHTML = tally
          .map(([verb, n]) =>
            `<span class="tally"><span class="n ${verb}">${n}</span>` +
            `<span class="verb">to ${verb}</span></span>`)
          .join('');
      }

      function renderBand(items) {
        const band = $('band');
        band.classList.toggle('bare', !items.length);
        band.innerHTML = items
          .map((r, i) =>
            `<button class="thread ${dye(r.sigil)}" style="--i:${i}" data-i="${i}"
               tabindex="-1" title="${esc(r.sigil.trim())} ${esc(r.name)}"></button>`)
          .join('');
      }

      function render() {
        for (const b of $('tabs').children) {
          const s = b.dataset.section;
          b.setAttribute('aria-selected', String(s === section));
          b.querySelector('.n').textContent = rowsIn(s).length || '';
        }

        // The band answers the query too. Leaving it showing all 62 threads
        // while the list shows one makes it decoration; fading the rest keeps
        // it the plan-at-a-glance it claims to be, and keeps the position of
        // a match visible in the whole.
        const shown = new Set(rowsIn('plan').map((r) => r.id));
        const items = snap.plan.items;
        for (const t of $('band').children) {
          const i = Number(t.dataset.i);
          t.setAttribute('aria-current', String(section === 'plan' && i === selected));
          t.classList.toggle('faded', !!query && !shown.has(items[i].id));
        }

        renderNew();
        const rows = rowsIn(section);
        const ul = $('rows');
        if (!rows.length) {
          const [said, run] = query
            ? [`Nothing here matches “${query}”.`, '']
            : EMPTY[section] || [`Nothing under \`${section}:\` yet.`, ''];
          ul.innerHTML = `<div class="empty"><pre>${esc(TENT)}</pre>${esc(said)}${
            run ? `<span class="do">${esc(run)}</span>` : ''
          }</div>`;
          $('details').className = 'hint';
          $('details').textContent = 'Nothing to show.';
          return;
        }
        selected = Math.min(selected, rows.length - 1);
        ul.innerHTML = rows
          .map(
            (r, i) => `<li data-i="${i}" aria-current="${i === selected}">
              <span class="sigil ${dye(r.sigil)}">${esc(r.sigil.trim() || '·')}</span>
              <span class="kind" title="${esc(r.kind)}">${
                icon(markFor(r, section))
              }<span class="kindword">${esc(r.kind)}</span></span>
              <span class="name">${esc(r.name)}</span>
              <span class="detail">${esc(r.detail)}</span>
            </li>`
          )
          .join('');
        renderDetails(rows[selected]);
      }

      /// The add affordance, and the form it opens. Only for sections that are
      /// a list of things you can declare -- plan, doctor and env describe the
      /// machine, and there is nothing to add to them.
      function renderNew(open = false) {
        const el = $('new');
        if (!writable || !NEW[section]) {
          el.innerHTML = '';
          return;
        }
        if (!open) {
          el.innerHTML =
            `<button class="add-row" id="opennew">${icon('add')}` +
            `<span>add a ${ONE[section]}</span></button>`;
          $('opennew').onclick = () => renderNew(true);
          return;
        }
        el.innerHTML =
          `<form class="newform" id="newform">${
            NEW[section]
              .map(
                (k) =>
                  `<label><span>${esc(k)}</span>` +
                  `<input name="${esc(k)}" spellcheck="false" autocomplete="off" /></label>`
              )
              .join('')
          }<div class="newact">` +
          `<button class="act-btn" type="submit" title="Add">${icon('save')}</button>` +
          `<button class="act-btn" type="button" id="newno" title="Cancel">${
            icon('cancel')
          }</button></div></form>`;
        $('newform').querySelector('input').focus();
        $('newno').onclick = () => renderNew(false);
        $('newform').onsubmit = (e) => {
          e.preventDefault();
          const fields = NEW[section]
            .map((k) => [k, new FormData(e.target).get(k).trim()])
            .filter(([, v]) => v);
          if (section === 'aliases') {
            const named = Object.fromEntries(fields);
            return send('PATCH', {
              section: 'aliases',
              name: named.name || '',
              key: 'value',
              value: named.value || '',
            });
          }
          send('POST', { section, fields });
        };
      }

      function renderDetails(r) {
        if (!r) return;
        const fields = [...(r.fields || [])];
        if (r.action) fields.unshift(['action', r.action]);
        if (r.needs_root) fields.push(['needs root', 'yes']);
        for (const [k, v] of r.arms || []) fields.push([`arm · ${k}`, v]);

        // What this row's own section allows. A plan or doctor row describes
        // the machine, not the config, so there is nothing here to edit.
        const raw = new Map((r.raw || []).map(([k, v]) => [k, v]));
        const canWrite = writable && !!r.section;

        const body = fields
          .map(([k, v]) => {
            const editable = canWrite && raw.has(k);
            const val = String(v).includes('\n')
              ? `<pre>${esc(v)}</pre>`
              : esc(v);
            return `<dt>${esc(k)}</dt><dd${
              editable ? ` class="can-edit" data-key="${esc(k)}"` : ''
            }>${val}${editable ? icon('edit', 'act') : ''}</dd>`;
          })
          .join('');

        $('details').className = '';
        $('details').innerHTML =
          `<div class="head"><span class="sigil ${dye(r.sigil)}">${
            esc(r.sigil.trim() || '·')
          }</span>${icon(markFor(r, section), 'big')}<span class="name">${
            esc(r.name)
          }</span>${
            canWrite
              ? `<button class="act-btn danger" id="del" title="Remove ${
                  esc(r.name)
                } from the config">${icon('delete')}</button>`
              : ''
          }</div><dl>${body}</dl>`;

        if (!canWrite) return;
        $('del').onclick = () => remove(r);
        for (const dd of $('details').querySelectorAll('dd.can-edit'))
          dd.onclick = () => openField(r, dd.dataset.key, raw.get(dd.dataset.key));
      }

      /// An inline editor seeded with the config's own text -- never the
      /// resolved value, or saving `{ macos: brew, default: apt }` would write
      /// `apt` and delete the macOS arm.
      function openField(r, key, rawValue) {
        const dd = $('details').querySelector(`dd[data-key="${CSS.escape(key)}"]`);
        dd.classList.add('editing');
        dd.innerHTML =
          `<input class="fld" value="${esc(rawValue)}" spellcheck="false" />` +
          `<button class="act-btn" data-go="1" title="Save">${icon('save')}</button>` +
          `<button class="act-btn" data-no="1" title="Cancel">${icon('cancel')}</button>`;
        const input = dd.querySelector('.fld');
        input.focus();
        input.select();
        const save = () =>
          send('PATCH', {
            section: r.section,
            name: r.name,
            key: r.section === 'aliases' ? 'value' : key,
            value: input.value,
          });
        dd.querySelector('[data-go]').onclick = save;
        dd.querySelector('[data-no]').onclick = () => render();
        input.onkeydown = (e) => {
          if (e.key === 'Enter') save();
          if (e.key === 'Escape') render();
          e.stopPropagation();
        };
      }

      function remove(r) {
        if (!confirm(`Remove ${r.name} from the config?`)) return;
        send('DELETE', { section: r.section, name: r.name });
      }

      /// Every write goes through here, so the header that defeats a drive-by
      /// POST cannot be forgotten at one call site.
      async function send(method, body) {
        note('');
        try {
          const res = await fetch('/api/entry', {
            method,
            headers: { 'content-type': 'application/json', 'X-Bedouin': '1' },
            body: JSON.stringify(body),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || res.statusText);
          // The server hands back the whole snapshot, so the page never has to
          // ask again and race the next edit.
          snap = data;
          renderVerdict();
          renderBand(snap.plan.items);
          render();
        } catch (e) {
          note(e.message || String(e));
        }
      }

      function note(msg) {
        $('note').innerHTML = msg ? `<div class="warn">${esc(msg)}</div>` : '';
      }

      function show(s, i = 0) {
        section = s;
        selected = i;
        render();
      }

      $('tabs').addEventListener('click', (e) => {
        const b = e.target.closest('button');
        if (b) show(b.dataset.section);
      });

      $('rows').addEventListener('click', (e) => {
        const li = e.target.closest('li');
        if (li) show(section, Number(li.dataset.i));
      });

      // A thread is the item. Picking one is how the band earns its place.
      $('band').addEventListener('click', (e) => {
        const t = e.target.closest('.thread[data-i]');
        if (t) show('plan', Number(t.dataset.i));
      });

      // Typing a query moves you to where the answer is. Searching "zellij"
      // from the plan tab and being shown an empty list, while packages holds
      // the one match, is the failure this avoids.
      $('q').addEventListener('input', (e) => {
        query = e.target.value.trim();
        selected = 0;
        if (query && !rowsIn(section).length) {
          const found = sections().find((s) => rowsIn(s).length);
          if (found) section = found;
        }
        render();
      });

      addEventListener('keydown', (e) => {
        // While the caret is in the search box, letters are letters.
        if (e.target === $('q')) {
          if (e.key === 'Escape') {
            $('q').value = '';
            query = '';
            $('q').blur();
            render();
          }
          return;
        }
        if (e.key === '/') {
          $('q').focus();
          $('q').select();
          e.preventDefault();
          return;
        }
        const n = rowsIn(section).length;
        const tabs = sections();
        const at = tabs.indexOf(section);
        if (e.key === 'j' || e.key === 'ArrowDown') show(section, Math.min(selected + 1, n - 1));
        else if (e.key === 'k' || e.key === 'ArrowUp') show(section, Math.max(selected - 1, 0));
        else if (e.key === 'ArrowRight') show(tabs[(at + 1) % tabs.length]);
        else if (e.key === 'ArrowLeft') show(tabs[(at - 1 + tabs.length) % tabs.length]);
        else return;
        e.preventDefault();
      });

      async function load() {
        try {
          const r = await fetch('/api/state');
          const body = await r.json().catch(() => null);
          // bedouin-ui says why it failed. Repeating the status line instead
          // of its answer is the one thing this screen must not do.
          if (!r.ok) throw new Error(body?.error || `${r.status} ${r.statusText}`);
          snap = body;
        } catch (err) {
          const said = err.message || String(err);
          $('machine').textContent = 'cannot read this machine';
          $('verdict').className = 'verdict pitched';
          $('verdict').textContent = 'no answer';
          renderBand([]);
          $('rows').innerHTML =
            `<div class="empty">${esc(said)}` +
            `<span class="do">check the terminal you started bedouin ui in</span></div>`;
          $('details').className = 'hint';
          $('details').textContent = 'Nothing to show.';
          return;
        }
        writable = !!snap.writable;
        const m = snap.machine;
        $('machine').innerHTML =
          `${esc(m.user)}@${esc(m.hostname)} · ${esc(m.distro)} ${esc(m.arch)}` +
          `<br>${esc(snap.config_path)}`;
        $('foot').innerHTML =
          (writable
            ? `Edits here change the config. <code>bedouin apply</code> changes the machine.`
            : `Read-only: not bound to loopback. <code>bedouin apply</code> changes the machine.`) +
          ` · bedouin-ui ${esc(snap.version)}`;
        // Directly under the verdict: a warning is a reason not to trust the
        // number above it, and it earns that place rather than the footer.
        $('warnings').innerHTML = snap.plan.warnings.length
          ? `<div class="warn">${snap.plan.warnings.map(esc).join('<br>')}</div>`
          : '';
        renderVerdict();
        renderBand(snap.plan.items);
        render();
      }

      load();
    </script>
  </body>
</html>
